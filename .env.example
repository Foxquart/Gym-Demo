DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gymdb?schema=public"

# Auth — replace in production
AUTH_SECRET="generate_with_openssl_rand_hex_32"

# Razorpay (test mode). Get keys at https://dashboard.razorpay.com/app/keys
# Leave blank to run checkout in MOCK mode (no network calls, payments still recorded).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Public origin used for absolute og:image / canonical URLs.
# Must match the domain the site is actually served from, or social cards break.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
